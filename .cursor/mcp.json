{
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "sequential-thinking-tools": {
      "command": "npx",
      "args": ["-y", "mcp-sequentialthinking-tools"]
    },
    "knowledge-graph-memory": {
      "command": "bash",
      "args": [
        "MCP_Implementations/knowledge-graph-memory/run.sh"
      ]
    },
    "sequential-thinking-mas": {
      "command": "bash",
      "args": [
        "MCP_Implementations/sequential-thinking-mas/run.sh"
      ],
      "env": {
        "LLM_PROVIDER": "deepseek"
      }
    },
    "fiction-reverse-engineering": {
      "command": "bash",
      "args": [
        "MCP_Implementations/fiction-reverse-engineering/run.sh"
      ]
    }
  }
}
